# Paste your Surrey Recreation search-results URL here (any `dates=` value is fine,
# it gets replaced automatically at runtime with a rolling window).
SURREY_SEARCH_URL=https://www.surrey.ca/parks-recreation/activities-registration/search-results?age_groups=adult&type=dropins&activities=drop_in_volleyball&locations=5fe86695-96dc-4afc-8415-3e03e7d22d91%2F0dd01783-dad1-4a11-bfa8-b6b1049bbf53%2F7d6c14d2-27dc-4c5d-8527-ef7e7fc57dd4%2Fa89fe9f3-5ece-4158-a87d-c61ec1e99601%2F0a9259fd-e827-477b-94a7-997feb0945d6%2F82750c43-8898-46b7-9bb2-eabd548f74cb%2F3c2aa8a6-94b9-4667-bd3e-545d2023fa4f%2F209e888a-2985-4ec7-9476-bbb3e24602cc%2F3cdb8e82-fa18-4255-8aba-0ecb93d69da4&dates=2026-08-09%2F2026-08-23

# How many days ahead of today to scrape the listing for (default 14)
LOOKAHEAD_DAYS=14

# Only sessions starting within this many days get their live registration
# status checked (registration opens 3 days before a session)
NOTIFY_WINDOW_DAYS=3

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Set one or both. DM requires the bot to share a server with you.
DISCORD_USER_ID=
DISCORD_CHANNEL_ID=

# Guild ID to sync slash commands to instantly while developing (right-click
# your server icon with Developer Mode on -> Copy Server ID). Leave unset in
# production to sync commands globally instead.
DISCORD_GUILD_ID=

# How often the background half-full watch loop runs, in minutes
WATCH_INTERVAL_MINUTES=15

# Fraction full (0-1) that triggers a notification
HALF_FULL_RATIO=0.5

# If a class's occurrence exactly one week before this one filled to at
# least this ratio, notify the moment registration opens for it instead of
# waiting for HALF_FULL_RATIO
POPULAR_FILL_RATIO=0.8

STATE_FILE=state.json
